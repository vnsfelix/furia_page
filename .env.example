# Somente no servidor. Nunca publicar este arquivo com valores reais.
# .env local não é carregado na Vercel: configurar no painel de cada ambiente.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SECRET_KEY=sb_secret_substitua_no_servidor
APP_URL=http://localhost:3000
# Produção: APP_URL=https://furiapage.vercel.app
# Alternativa legada: SUPABASE_SERVICE_ROLE_KEY (JWT service_role).
# Chaves publishable/anon não são aceitas pelo backend.

# Telegram é opcional e só será ativado quando as três variáveis estiverem presentes.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
CRON_SECRET=

