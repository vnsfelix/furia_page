# Porta do Servidor
PORT=3000

# Ambiente (development / production)
NODE_ENV=development

# Origens permitidas para o CORS (use * para desenvolvimento ou o domínio do frontend)
CORS_ORIGIN=*

# Segredo para autenticação JWT / Sessões
JWT_SECRET=furia_segredo_super_forte_para_autenticacao_2026

# Conexão com o Banco de Dados (quando você for implementar)
# Exemplos:
# SQLite: DB_TYPE=sqlite | DB_PATH=./src/db/database.sqlite
# PostgreSQL: DATABASE_URL=postgresql://usuario:senha@localhost:5432/furia_db
# MySQL: DATABASE_URL=mysql://usuario:senha@localhost:3306/furia_db
# MongoDB: MONGODB_URI=mongodb://localhost:27017/furia_db

